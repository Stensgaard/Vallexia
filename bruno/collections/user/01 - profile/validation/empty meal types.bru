meta {
  name: empty meal types
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "{{registeredEmail}}",
    "householdSize": 1,
    "mealTypes": []
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Meal types validation error", function() {
    expect(res.body.details).to.have.property("mealTypes");
    expect(res.body.details.mealTypes).to.satisfy(msg => "At least one meal type must be selected");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
