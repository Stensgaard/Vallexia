meta {
  name: update user profile
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "updated{{$timestamp}}@example.com",
    "householdSize": 3,
    "mealTypes": ["BREAKFAST", "LUNCH", "DINNER", "SNACK"]
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains updated email", function() {
    expect(res.body).to.have.property("email");
    expect(res.body.email).to.be.a("string");
  });
  
  test("Response contains updated household size", function() {
    expect(res.body.householdSize).to.equal(3);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
