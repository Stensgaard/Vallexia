meta {
  name: email already in use
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "{{conflictEmail}}",
    "householdSize": 2,
    "mealTypes": ["BREAKFAST", "LUNCH", "DINNER"]
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Error message indicates email already in use", function() {
    expect(res.body.message).to.satisfy(msg => 
      msg.includes("already in use") || msg.includes("Email") || msg.includes("conflict")
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
