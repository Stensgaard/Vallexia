meta {
  name: missing email
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "householdSize": 2,
    "mealTypes": ["BREAKFAST", "LUNCH", "DINNER"]
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Missing email error", function() {
    expect(res.body.details).to.have.property("email");
    expect(res.body.details.mealTypes).to.satisfy(msg => "Email is required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
