meta {
  name: wrong restrictions
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/dietary-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "restrictions": ["invalid.restriction", "GLUTEN_FREE"],
    "allergies": ["PEANUTS", "TREE_NUTS"],
    "preferredCuisines": ["ITALIAN", "MEDITERRANEAN"]
  }
}

tests {
  test("Status is 400 bad request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Error code is VAL_002", function() {
    expect(res.body.code).to.equal("VAL_002");
  });
  
  test("dietary restrictions validation error", function() {
    expect(res.body.details.requestBody).to.satisfy(msg => "DAIRY_FREE");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
