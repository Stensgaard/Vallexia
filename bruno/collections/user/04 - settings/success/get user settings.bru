meta {
  name: get user settings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/users/settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains user ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
  });
  
  test("Response contains language", function() {
    expect(res.body).to.have.property("language");
    expect(res.body.language).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
