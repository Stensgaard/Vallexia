meta {
  name: updating with missing fields
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "firstDayOfWeek": "SUNDAY",
    "measurementSystem": "METRIC",
    "currency": "DKK"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Missing country value", function() {
    expect(res.body.details).to.have.property("country");
    expect(res.body.details.country).to.satisfy(msg => "Country is required");
  });
  
  test("Missing date format value", function() {
    expect(res.body.details).to.have.property("dateFormat");
    expect(res.body.details.dateFormat).to.satisfy(msg => "Date format code is required");
  });
  
  test("Missing timezone value", function() {
    expect(res.body.details).to.have.property("timezone");
    expect(res.body.details.timezone).to.satisfy(msg => "Timezone is required");
  });
  
  test("Missing language value", function() {
    expect(res.body.details).to.have.property("language");
    expect(res.body.details.language).to.satisfy(msg => "Language is required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
