meta {
  name: updating currency value to over max value
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "language": "en",
    "country": "DK",
    "dateFormat": "DD_MM_YYYY_DOT",
    "timezone": "Europe/Copenhagen",
    "firstDayOfWeek": "SUNDAY",
    "measurementSystem": "METRIC",
    "currency": "invalid"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Currency validation error with too long value", function() {
    expect(res.body.details).to.have.property("currency");
    expect(res.body.details.currency).to.satisfy(msg => "Currency code must not exceed 3 characters");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
