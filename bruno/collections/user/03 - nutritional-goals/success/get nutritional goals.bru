meta {
  name: get nutritional goals
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/users/nutritional-goals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains dailyCalories", function() {
    expect(res.body).to.have.property("dailyCalories");
  });
  
  test("Response contains userId", function() {
    expect(res.body).to.have.property("userId");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
