meta {
  name: updating fats value to over max
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/nutritional-goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dailyCalories": 2000.0,
    "dailyProtein": 150.0,
    "dailyCarbs": 200.0,
    "dailyFats": 501.0
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Fats validation error for too high", function() {
    expect(res.body.details).to.have.property("dailyFats");
    expect(res.body.details.dailyFats).to.satisfy(msg => "Daily fats must not exceed");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
