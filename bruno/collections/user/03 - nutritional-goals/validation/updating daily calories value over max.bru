// TODO validate this is the case and fix if so
/*
Assertion checks `res.body.details.dailyProtein` when testing daily calories 
maximum validation error, but should check `res.body.details.dailyCalories`. 
This will fail to validate the correct error field. 
*/

meta {
  name: updating daily calories value over max
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/nutritional-goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dailyCalories": 10001.0,
    "dailyProtein": 150.0,
    "dailyCarbs": 200.0,
    "dailyFats": 65.0
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Daily calories validation error for too high", function() {
    expect(res.body.details).to.have.property("dailyCalories");
    expect(res.body.details.dailyProtein).to.satisfy(msg => "Daily calories must not exceed");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
