meta {
  name: updating sugar value to over max
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/nutritional-goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dailyCalories": 2000.0,
    "dailyProtein": 150.0,
    "dailyCarbs": 200.0,
    "dailyFats": 65.0,
    "dailySugar": 10001.0
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Sugar validation error for too high", function() {
    expect(res.body.details).to.have.property("dailySugar");
    expect(res.body.details.dailySugar).to.satisfy(msg => "Daily sugar must not exceed");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
