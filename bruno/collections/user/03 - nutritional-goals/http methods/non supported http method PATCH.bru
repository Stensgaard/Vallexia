meta {
  name: non supported http method PATCH
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/{{apiVersion}}/users/nutritional-goals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 405 Method Not Allowed", function() {
    expect(res.status).to.equal(405);
  });
  
  test("Http response include allowed http methods", function() {
    expect(res.body.details).to.have.property("error");
    expect(res.body.details.error).to.include("Supported methods");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
