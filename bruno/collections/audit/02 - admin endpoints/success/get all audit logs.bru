meta {
  name: get all audit logs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs?page=0&size=20
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 20
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains paginated audit logs", function() {
    expect(res.body).to.have.property("content");
    expect(res.body).to.have.property("totalPages");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
