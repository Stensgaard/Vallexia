meta {
  name: get audit logs using date range
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/date-range?start=2024-01-01T00:00:00&end=2024-01-31T23:59:59&page=0&size=20
  body: none
  auth: bearer
}

params:query {
  start: 2024-01-01T00:00:00
  end: 2024-01-31T23:59:59
  page: 0
  size: 20
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains audit logs in date range", function() {
    expect(res.body).to.have.property("content");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
