meta {
  name: get failed login attempts for a user
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/failed-logins?username={{registeredUsername}}&page=0&size=20
  body: none
  auth: bearer
}

params:query {
  username: {{registeredUsername}}
  page: 0
  size: 20
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains failed login attempts", function() {
    expect(res.body).to.have.property("content");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
