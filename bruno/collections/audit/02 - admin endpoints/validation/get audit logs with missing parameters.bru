meta {
  name: get audit logs with missing parameters
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/date-range?page=0&size=20
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 20
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 400 Bad Request (missing required parameters)", function() {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
