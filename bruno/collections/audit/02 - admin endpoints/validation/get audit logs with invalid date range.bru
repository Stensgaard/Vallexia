meta {
  name: get audit logs with invalid date range
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/date-range?start=2024-01-01&end=2024-01-31&page=0&size=20
  body: none
  auth: bearer
}

params:query {
  start: 2024-01-01
  end: 2024-01-31
  page: 0
  size: 20
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 400 Bad Request (invalid date format)", function() {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
