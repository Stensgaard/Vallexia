meta {
  name: invalid user id format
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/user/invalid-id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
