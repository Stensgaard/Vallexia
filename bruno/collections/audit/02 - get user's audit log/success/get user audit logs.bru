meta {
  name: get user audit logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/{{apiVersion}}/audit-logs/user/{{registeredUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains pagination structure", function() {
    expect(res.body).to.have.property("content");
    expect(res.body).to.have.property("totalElements");
    expect(res.body).to.have.property("totalPages");
    expect(res.body).to.have.property("number");
    expect(res.body).to.have.property("size");
  });
  
  test("Response contains audit log array", function() {
    expect(res.body.content).to.be.an("array");
  });
  
  test("Audit logs have required properties", function() {
    if (res.body.content.length > 0) {
      const log = res.body.content[0];
      expect(log).to.have.property("eventType");
      expect(log).to.have.property("eventDescription");
      expect(log).to.have.property("timestamp");
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
