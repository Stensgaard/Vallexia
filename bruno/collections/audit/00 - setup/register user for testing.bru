meta {
  name: register user for testing
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "{{password}}",
    "confirmPassword": "{{password}}"
  }
}

tests {
  // NOTE: used for testing user endpoints
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  bru.setVar("accessToken", res.body.accessToken);
  bru.setVar("refreshToken", res.body.refreshToken);
  bru.setVar("registeredUsername", res.body.username);
  bru.setVar("registeredEmail", res.body.email);
}

settings {
  encodeUrl: true
  timeout: 0
}
