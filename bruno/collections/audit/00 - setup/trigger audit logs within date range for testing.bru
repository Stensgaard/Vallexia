meta {
  name: trigger audit logs within date range for testing
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/{{apiVersion}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "daterange{{$timestamp}}@example.com",
    "householdSize": 2,
    "mealTypes": ["BREAKFAST", "LUNCH", "DINNER"]
  }
}

pre-request {
  // Calculate date range before API call to ensure audit log falls within range
  const now = new Date();
  const startDate = new Date(now.getTime() - 120000); // 2 minutes ago
  const endDate = new Date(now.getTime() + 120000); // 2 minutes from now
  
  bru.setVar("dateRangeStart", startDate.toISOString().slice(0, 19));
  bru.setVar("dateRangeEnd", endDate.toISOString().slice(0, 19));
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
