meta {
  name: missing password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "",
    "confirmPassword": "{{password}}"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error in details", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.include("required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
