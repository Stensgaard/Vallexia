meta {
  name: password mismatch
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "{{password}}",
    "confirmPassword": "123456"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Error message indicates password mismatch", function() {
    expect(res.body.message).to.satisfy(msg => "Password and confirmation password do not match");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
