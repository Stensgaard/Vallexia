meta {
  name: too long password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "ThisPasswordIsWayTooLongAndExceedsFortyChars1!",
    "confirmPassword": "ThisPasswordIsWayTooLongAndExceedsFortyChars1!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error for too long", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => "Password must be between");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
