meta {
  name: weak password - no special characters
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "TestPass123",
    "confirmPassword": "TestPass123"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error for missing special character", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => 
      msg.includes("special") || msg.includes("character") || msg.includes("Password must")
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
