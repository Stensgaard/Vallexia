meta {
  name: missing confirm password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "{{password}}",
    "confirmPassword": ""
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Confirm password validation error in details", function() {
    expect(res.body.details).to.have.property("confirmPassword");
    expect(res.body.details.confirmPassword).to.include("required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
