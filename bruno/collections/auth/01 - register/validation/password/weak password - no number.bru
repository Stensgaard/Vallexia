// TODO validate this is the case and fix if so
/*
Test assertions use `&&` operator inside `satisfy()` callback which performs 
logical AND on string literals, not validation. Expression like `"must contain" && "lowercase"` 
evaluates to the second string, not a proper boolean validation. 
Should use `||` for alternatives or `includes()` for substring checks. 
*/

meta {
  name: weak password - no number
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "TestPass!",
    "confirmPassword": "TestPass!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error for missing number", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => "must contain" && "number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
