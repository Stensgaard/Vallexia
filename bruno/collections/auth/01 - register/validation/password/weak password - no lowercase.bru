meta {
  name: weak password - no lowercase
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "TESTPASS123!",
    "confirmPassword": "TESTPASS123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error for missing lowercase", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => msg.includes("must contain") && msg.includes("lowercase"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
