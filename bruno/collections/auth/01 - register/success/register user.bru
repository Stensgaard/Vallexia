meta {
  name: register user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}{{$timestamp}}",
    "email": "{{email}}{{$timestamp}}@example.com",
    "country": "{{country}}",
    "password": "{{password}}",
    "confirmPassword": "{{password}}"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Response contains access token", function() {
    expect(res.body).to.have.property("accessToken");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("accessToken", res.body.accessToken);
  });
  
  test("Response contains username", function() {
    expect(res.body).to.have.property("username");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("registeredUsername", res.body.username);
  });
  
  test("Response contains email", function() {
    expect(res.body).to.have.property("email");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("registeredEmail", res.body.email);
  });
  
  test("Response contains refresh token", function() {
    expect(res.body).to.have.property("refreshToken");
    expect(res.body.refreshToken).to.be.a("string");
    bru.setVar("refreshToken", res.body.refreshToken);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
