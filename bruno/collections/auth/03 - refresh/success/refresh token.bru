meta {
  name: refresh token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/refresh
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains new access token", function() {
    expect(res.body).to.have.property("accessToken");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("accessToken", res.body.accessToken);
  });
  
  test("Response contains new refresh token", function() {
    expect(res.body).to.have.property("refreshToken");
    expect(res.body.refreshToken).to.be.a("string");
    bru.setVar("refreshToken", res.body.refreshToken);
  });
  
  test("New refresh token is different (token rotation)", function() {
    const oldToken = bru.getVar("refreshToken");
    const newToken = res.body.refreshToken;
    // Note: This test validates token rotation if old token is still available
    expect(newToken).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
