meta {
  name: user does not exist
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "usernameOrEmail": "neverregistered@example.com",
    "password": "{{password}}"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  
  test("Error code is AUTH_002", function() {
    expect(res.body.code).to.equal("AUTH_002");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
