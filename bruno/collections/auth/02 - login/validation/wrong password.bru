meta {
  name: wrong password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "usernameOrEmail": "{{registeredUsername}}",
    "password": "wrong"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  
  test("Error code is AUTH_002", function() {
    expect(res.body.code).to.equal("AUTH_002");
  });
  
  test("Error message indicates invalid credentials", function() {
    expect(res.body.message).to.satisfy(msg => "Invalid username/email or password");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
