meta {
  name: missing username/email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "usernameOrEmail": "",
    "password": "{{password}}"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Username validation error in details", function() {
    expect(res.body.details).to.have.property("usernameOrEmail");
    expect(res.body.details.usernameOrEmail).to.include("required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
