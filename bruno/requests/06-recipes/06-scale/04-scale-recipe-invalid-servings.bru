meta {
  name: Scale Recipe - Invalid Servings
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}/scale?servings=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });
}

