meta {
  name: Scale Recipe - Unauthenticated
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}/scale?servings=6
  body: none
  auth: none
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error code indicates authentication required", function() {
    expect(res.body).to.have.property("code");
    expect(res.body.code).to.equal("AUTH_001");
  });
}

