meta {
  name: Scale Recipe - Success
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}/scale?servings=8
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains scaled recipe", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("servings");
  });

  test("Servings is scaled correctly", function() {
    expect(res.body.servings).to.equal(8);
  });

  test("Ingredients are scaled", function() {
    if (res.body.ingredients && res.body.ingredients.length > 0) {
      expect(res.body.ingredients).to.be.an("array");
    }
  });
}

