meta {
  name: Search Recipes - By Cuisine Success
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/recipes/search?cuisineType=ITALIAN&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains recipes", function() {
    expect(res.body).to.have.property("recipes");
    expect(res.body.recipes).to.be.an("array");
  });

  test("All results have correct cuisine type", function() {
    if (res.body.recipes.length > 0) {
      res.body.recipes.forEach(function(recipe) {
        expect(recipe.cuisineType).to.equal("ITALIAN");
      });
    }
  });
}

