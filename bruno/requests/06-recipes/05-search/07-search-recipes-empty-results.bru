meta {
  name: Search Recipes - Empty Results
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/recipes/search?query=nonexistentrecipexyz123&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Results array is empty", function() {
    expect(res.body).to.have.property("recipes");
    expect(res.body.recipes).to.be.an("array");
    expect(res.body.recipes.length).to.equal(0);
  });

  test("Total elements is 0", function() {
    expect(res.body.pagination.totalElements).to.equal(0);
  });
}

