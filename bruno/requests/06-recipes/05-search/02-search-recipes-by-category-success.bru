meta {
  name: Search Recipes - By Category Success
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/recipes/search?category=DINNER&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains recipes", function() {
    expect(res.body).to.have.property("recipes");
    expect(res.body.recipes).to.be.an("array");
  });

  test("All results have correct category", function() {
    if (res.body.recipes.length > 0) {
      res.body.recipes.forEach(function(recipe) {
        expect(recipe.category).to.equal("DINNER");
      });
    }
  });
}

