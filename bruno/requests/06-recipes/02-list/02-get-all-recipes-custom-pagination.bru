meta {
  name: Get All Recipes - Custom Pagination
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/recipes?page=1&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has correct page size", function() {
    expect(res.body.size).to.equal(10);
  });

  test("Response has correct page number", function() {
    expect(res.body.number).to.equal(1);
  });

  test("Content array size matches page size", function() {
    expect(res.body.content.length).to.be.at.most(10);
  });
}

