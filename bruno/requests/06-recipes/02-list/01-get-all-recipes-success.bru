meta {
  name: Get All Recipes - Success
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/recipes?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains content array", function() {
    expect(res.body).to.have.property("content");
    expect(res.body.content).to.be.an("array");
  });

  test("Response contains pagination info", function() {
    expect(res.body).to.have.property("totalElements");
    expect(res.body.totalElements).to.be.a("number");
    expect(res.body).to.have.property("totalPages");
    expect(res.body.totalPages).to.be.a("number");
    expect(res.body).to.have.property("size");
    expect(res.body.size).to.equal(20);
    expect(res.body).to.have.property("number");
    expect(res.body.number).to.equal(0);
  });
}

