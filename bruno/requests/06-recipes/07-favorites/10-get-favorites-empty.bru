meta {
  name: Get Favorites - Empty
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/recipes/favorites?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Content array is empty", function() {
    expect(res.body.content).to.be.an("array");
    expect(res.body.content.length).to.equal(0);
  });

  test("Total elements is 0", function() {
    expect(res.body.totalElements).to.equal(0);
  });
}

