meta {
  name: Add Favorite - Duplicate
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}/favorite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 204 No Content (idempotent)", function() {
    expect(res.status).to.equal(204);
  });

  test("Response body is empty", function() {
    expect(res.body).to.be.empty;
  });
}

