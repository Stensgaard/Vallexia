meta {
  name: Remove Favorite - Not Found
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/v1/recipes/999999/favorite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 204 No Content (idempotent)", function() {
    expect(res.status).to.equal(204);
  });

  test("Response body is empty", function() {
    expect(res.body).to.be.empty;
  });
}

