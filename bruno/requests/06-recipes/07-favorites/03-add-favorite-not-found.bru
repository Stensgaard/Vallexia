meta {
  name: Add Favorite - Not Found
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/recipes/999999/favorite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 404 Not Found", function() {
    expect(res.status).to.equal(404);
  });
  
  test("Error code is REC_001", function() {
    expect(res.body.code).to.equal("REC_001");
  });
}
