meta {
  name: Get Recipe By ID - Success
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains recipe ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
  });

  test("Response contains recipe name", function() {
    expect(res.body).to.have.property("name");
    expect(res.body.name).to.be.a("string");
  });

  test("Response contains instructions", function() {
    expect(res.body).to.have.property("instructions");
    expect(res.body.instructions).to.be.a("string");
  });

  test("Response contains servings", function() {
    expect(res.body).to.have.property("servings");
    expect(res.body.servings).to.be.a("number");
  });

  test("Response contains category", function() {
    expect(res.body).to.have.property("category");
  });
}

