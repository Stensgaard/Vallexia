meta {
  name: Delete Recipe - Success
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 204 No Content", function() {
    expect(res.status).to.equal(204);
  });

  test("Response body is empty", function() {
    expect(res.body).to.be.empty;
  });
}

