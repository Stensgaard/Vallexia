meta {
  name: Delete Recipe - Forbidden
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/recipes/{{minimalRecipeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 403 Forbidden", function() {
    expect(res.status).to.equal(403);
  });

  test("Error code indicates forbidden", function() {
    expect(res.body.code).to.equal("AUTH_005");
  });
}

