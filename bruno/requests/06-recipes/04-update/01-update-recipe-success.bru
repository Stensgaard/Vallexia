meta {
  name: Update Recipe - Success
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/recipes/{{createdRecipeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Updated Recipe Name",
    "description": "Updated description",
    "instructions": "Updated instructions",
    "prepTimeMinutes": 20,
    "cookTimeMinutes": 40,
    "servings": 6,
    "difficultyLevel": "HARD",
    "category": "LUNCH",
    "cuisineType": "MEXICAN",
    "isPublic": false
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains updated name", function() {
    expect(res.body.name).to.equal("Updated Recipe Name");
  });
  
  test("Response contains updated fields", function() {
    expect(res.body.description).to.equal("Updated description");
    expect(res.body.servings).to.equal(6);
    expect(res.body.category).to.equal("LUNCH");
    expect(res.body.cuisineType).to.equal("MEXICAN");
  });
}
