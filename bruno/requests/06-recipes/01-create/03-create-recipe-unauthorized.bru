meta {
  name: Create Recipe - Unauthorized
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: none
}

body:json {
  {
    "name": "Test Recipe",
    "instructions": "Test instructions",
    "servings": 4,
    "category": "DINNER"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  
  test("Error code indicates Unauthorized", function() {
    expect(res.body.code).to.satisfy(code => 
      code.includes("AUTH_001") || code.includes("Authentication failed")
    );
  });
}
