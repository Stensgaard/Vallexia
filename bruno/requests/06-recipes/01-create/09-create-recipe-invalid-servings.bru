meta {
  name: Create Recipe - Invalid Servings
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Test Recipe",
    "instructions": "Test instructions",
    "servings": 0,
    "category": "DINNER"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });

  test("Servings validation error in details", function() {
    expect(res.body.details).to.have.property("servings");
    expect(res.body.details.servings).to.satisfy(msg => 
      msg.includes("at least 1") || msg.includes("minimum") || msg.includes("greater")
    );
  });
}

