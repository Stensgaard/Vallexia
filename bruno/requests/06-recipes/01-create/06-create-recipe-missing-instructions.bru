meta {
  name: Create Recipe - Missing Instructions
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Test Recipe",
    "servings": 4,
    "category": "DINNER"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });

  test("Instructions validation error in details", function() {
    expect(res.body.details).to.have.property("instructions");
    expect(res.body.details.instructions).to.satisfy(msg => 
      msg.includes("required") || msg.includes("blank")
    );
  });
}

