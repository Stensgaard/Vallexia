meta {
  name: Create Recipe - Missing Category
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Test Recipe",
    "instructions": "Test instructions",
    "servings": 4
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });

  test("Category validation error in details", function() {
    expect(res.body.details).to.have.property("category");
    expect(res.body.details.category).to.satisfy(msg => 
      msg.includes("required") || msg.includes("null")
    );
  });
}

