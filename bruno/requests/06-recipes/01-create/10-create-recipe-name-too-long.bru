meta {
  name: Create Recipe - Name Too Long
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "instructions": "Test instructions",
    "servings": 4,
    "category": "DINNER"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });

  test("Name validation error in details", function() {
    expect(res.body.details).to.have.property("name");
    expect(res.body.details.name).to.satisfy(msg => 
      msg.includes("255") || msg.includes("exceed") || msg.includes("maximum")
    );
  });
}

