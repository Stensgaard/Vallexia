meta {
  name: Create Recipe - Minimal Success
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Minimal Recipe",
    "instructions": "Simple instructions",
    "servings": 2,
    "category": "BREAKFAST",
    "isPublic": true
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Response contains recipe ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
    bru.setVar("minimalRecipeId", res.body.id);
  });
  
  test("Response contains required fields", function() {
    expect(res.body.name).to.equal("Minimal Recipe");
    expect(res.body.instructions).to.equal("Simple instructions");
    expect(res.body.servings).to.equal(2);
    expect(res.body.category).to.equal("BREAKFAST");
  });
}
