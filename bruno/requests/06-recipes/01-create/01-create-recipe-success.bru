meta {
  name: Create Recipe - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Test Recipe Full",
    "description": "A comprehensive test recipe with all fields",
    "instructions": "Step 1: Prepare ingredients. Step 2: Cook. Step 3: Serve.",
    "prepTimeMinutes": 15,
    "cookTimeMinutes": 30,
    "servings": 4,
    "difficultyLevel": "MEDIUM",
    "category": "DINNER",
    "cuisineType": "ITALIAN",
    "imageUrl": "https://example.com/recipe.jpg",
    "isPublic": true,
    "tags": ["easy", "italian", "dinner"]
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Response contains recipe ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
    bru.setVar("createdRecipeId", res.body.id);
    bru.setVar("recipeId", res.body.id);
  });
  
  test("Response contains recipe name", function() {
    expect(res.body.name).to.equal("Test Recipe Full");
  });
  
  test("Response contains all provided fields", function() {
    expect(res.body.description).to.equal("A comprehensive test recipe with all fields");
    expect(res.body.servings).to.equal(4);
    expect(res.body.category).to.equal("DINNER");
    expect(res.body.cuisineType).to.equal("ITALIAN");
  });
}
