meta {
  name: Create Recipe - Private Success
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/recipes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "name": "Private Test Recipe",
    "description": "A private recipe for testing",
    "instructions": "Step 1: Prepare. Step 2: Cook. Step 3: Serve.",
    "prepTimeMinutes": 10,
    "cookTimeMinutes": 20,
    "servings": 2,
    "difficultyLevel": "EASY",
    "category": "LUNCH",
    "cuisineType": "AMERICAN",
    "isPublic": false
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Response contains recipe ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
    bru.setVar("privateRecipeId", res.body.id);
  });
  
  test("Recipe is marked as private", function() {
    expect(res.body.isPublic).to.equal(false);
  });
  
  test("Response contains required fields", function() {
    expect(res.body.name).to.equal("Private Test Recipe");
    expect(res.body.servings).to.equal(2);
    expect(res.body.category).to.equal("LUNCH");
  });
}
