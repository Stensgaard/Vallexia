meta {
  name: Refresh Token - Expired Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "expired.refresh.token.here"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error code is AUTH_003 or AUTH_004", function() {
    expect(["AUTH_003", "AUTH_004"]).to.include(res.body.code);
  });
}
