meta {
  name: Refresh Token - Invalid Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "invalid.token.here"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error code is AUTH_004", function() {
    expect(res.body.code).to.equal("AUTH_004");
  });

  test("Error message indicates invalid token", function() {
    expect(res.body.message).to.satisfy(msg => 
      msg.includes("Invalid") || msg.includes("token")
    );
  });
}
