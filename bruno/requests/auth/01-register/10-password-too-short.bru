meta {
  name: Register - Password Too Short
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "test@example.com",
    "password": "Abc1@XY",
    "confirmPassword": "Abc1@XY"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Password validation error for too short", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => 
      msg.includes("8") || msg.includes("between") || msg.includes("characters")
    );
  });
}
