meta {
  name: Login - Wrong Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usernameOrEmail": "{{registeredEmail}}",
    "password": "WrongPassword123!"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("Error code is AUTH_002", function() {
    expect(res.body.code).to.equal("AUTH_002");
  });

  test("Error message indicates invalid credentials", function() {
    expect(res.body.message).to.satisfy(msg => 
      msg.includes("Invalid username") || msg.includes("Invalid") || msg.includes("password")
    );
  });
}
