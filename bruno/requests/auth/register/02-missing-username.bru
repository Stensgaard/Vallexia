meta {
  name: Register - Missing Username
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "TestPass123!",
    "confirmPassword": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error code is VAL_001", function() {
    expect(res.body.code).to.equal("VAL_001");
  });

  test("Response has validation details", function() {
    expect(res.body).to.have.property("details");
    expect(res.body.details).to.be.an("object");
  });

  test("Username validation error in details", function() {
    expect(res.body.details).to.have.property("username");
    expect(res.body.details.username).to.include("required");
  });

  test("Response has requestId for tracing", function() {
    expect(res.body).to.have.property("requestId");
    expect(res.body.requestId).to.be.a("string");
  });
}
