meta {
  name: Register - Password Weak No Lowercase
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "test@example.com",
    "password": "TESTPASS123!",
    "confirmPassword": "TESTPASS123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Password validation error for missing lowercase", function() {
    expect(res.body.details).to.have.property("password");
    expect(res.body.details.password).to.satisfy(msg => 
      msg.includes("lowercase") || msg.includes("character") || msg.includes("Password must")
    );
  });
}
