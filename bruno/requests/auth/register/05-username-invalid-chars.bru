meta {
  name: Register - Username Invalid Characters
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "test user@123",
    "email": "test@example.com",
    "password": "TestPass123!",
    "confirmPassword": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Username validation error for invalid characters", function() {
    expect(res.body.details).to.have.property("username");
    expect(res.body.details.username).to.satisfy(msg => 
      msg.includes("letters") || msg.includes("numbers") || msg.includes("underscores") || msg.includes("dashes")
    );
  });
}
