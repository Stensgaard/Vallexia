meta {
  name: Register - Missing Confirm Password
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "test@example.com",
    "password": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Confirm password validation error in details", function() {
    expect(res.body.details).to.have.property("confirmPassword");
    expect(res.body.details.confirmPassword).to.include("required");
  });
}
