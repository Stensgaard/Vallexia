meta {
  name: Register - Username Too Long
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "thisusernameistoolongforthelimit",
    "email": "test@example.com",
    "password": "TestPass123!",
    "confirmPassword": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Username validation error for too long", function() {
    expect(res.body.details).to.have.property("username");
    expect(res.body.details.username).to.satisfy(msg => 
      msg.includes("20") || msg.includes("characters") || msg.includes("between")
    );
  });
}
