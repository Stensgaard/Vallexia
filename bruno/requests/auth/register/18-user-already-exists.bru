meta {
  name: Register - User Already Exists
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{registeredUsername}}",
    "email": "{{registeredEmail}}",
    "password": "{{testPassword}}",
    "confirmPassword": "{{testPassword}}"
  }
}

tests {
  test("Status is 409 Conflict", function() {
    expect(res.status).to.equal(409);
  });

  test("Error code is USER_002", function() {
    expect(res.body.code).to.equal("USER_002");
  });

  test("Error message indicates user already exists", function() {
    expect(res.body.message).to.satisfy(msg => 
      msg.includes("already exists") || msg.includes("taken") || msg.includes("User already")
    );
  });
}
