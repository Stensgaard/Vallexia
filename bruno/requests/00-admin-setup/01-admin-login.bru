meta {
  name: Admin Login - Setup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usernameOrEmail": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains admin access token", function() {
    expect(res.body).to.have.property("accessToken");
    expect(res.body.accessToken).to.be.a("string");
    bru.setVar("adminAccessToken", res.body.accessToken);
  });

  test("Response contains admin refresh token", function() {
    expect(res.body).to.have.property("refreshToken");
    expect(res.body.refreshToken).to.be.a("string");
  });

  test("Response contains admin user ID", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
  });
}
