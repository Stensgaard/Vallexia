meta {
  name: Register - Invalid Email Format
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "not-an-email",
    "password": "TestPass123!",
    "confirmPassword": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Email validation error for invalid format", function() {
    expect(res.body.details).to.have.property("email");
    expect(res.body.details.email).to.satisfy(msg => 
      msg.includes("valid") || msg.includes("Email")
    );
  });
}
