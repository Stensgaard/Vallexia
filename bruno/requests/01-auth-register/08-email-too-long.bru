meta {
  name: Register - Email Too Long
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "verylongemailaddressthatexceedsfiftycharacterslimit@example.com",
    "password": "TestPass123!",
    "confirmPassword": "TestPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Email validation error for too long", function() {
    expect(res.body.details).to.have.property("email");
    expect(res.body.details.email).to.satisfy(msg => 
      msg.includes("50") || msg.includes("exceed") || msg.includes("characters")
    );
  });
}
