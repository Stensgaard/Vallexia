meta {
  name: Register - Password Mismatch
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "email": "test@example.com",
    "password": "TestPass123!",
    "confirmPassword": "DifferentPass123!"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Error message indicates password mismatch", function() {
    expect(res.body.message).to.satisfy(msg => 
      msg.includes("match") || msg.includes("Password") || msg.includes("confirmation")
    );
  });
}
