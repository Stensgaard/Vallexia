meta {
  name: Update Dietary Preferences - Missing Serving Size
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/users/dietary-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "restrictions": ["VEGETARIAN"],
    "allergies": ["PEANUTS"]
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Serving size preference validation error in details", function() {
    expect(res.body.details).to.have.property("servingSizePreference");
    expect(res.body.details.servingSizePreference).to.include("required");
  });
}
