meta {
  name: Update Dietary Preferences - Success
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/users/dietary-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "restrictions": ["VEGETARIAN", "GLUTEN_FREE"],
    "allergies": ["PEANUTS", "TREE_NUTS"],
    "preferredCuisines": ["ITALIAN", "MEDITERRANEAN"],
    "dislikedIngredients": ["cilantro", "mushrooms"],
    "servingSizePreference": "MEDIUM"
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains updated restrictions", function() {
    expect(res.body).to.have.property("restrictions");
    expect(res.body.restrictions).to.be.an("array");
  });

  test("Response contains updated serving size preference", function() {
    expect(res.body.servingSizePreference).to.equal("MEDIUM");
  });
}
