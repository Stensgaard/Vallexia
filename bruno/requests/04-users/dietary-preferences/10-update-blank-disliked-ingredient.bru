meta {
  name: Update Dietary Preferences - Blank Disliked Ingredient
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/v1/users/dietary-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dislikedIngredients": ["cilantro", "", "mushrooms"],
    "servingSizePreference": "MEDIUM"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Disliked ingredient validation error for blank", function() {
    expect(res.body.details).to.have.property("dislikedIngredients");
    expect(res.body.details.dislikedIngredients).to.satisfy(msg => 
      msg.includes("cannot be blank") || msg.includes("blank") || msg.includes("not be blank")
    );
  });
}
