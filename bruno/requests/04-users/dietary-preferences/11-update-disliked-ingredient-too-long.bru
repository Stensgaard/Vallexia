meta {
  name: Update Dietary Preferences - Disliked Ingredient Too Long
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/v1/users/dietary-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dislikedIngredients": ["ThisIsAVeryLongIngredientNameThatExceedsOneHundredCharactersInLengthAndShouldFailValidationAccordingToTheSizeConstraint"],
    "servingSizePreference": "MEDIUM"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Disliked ingredient validation error for too long", function() {
    expect(res.body.details).to.have.property("dislikedIngredients");
    expect(res.body.details.dislikedIngredients).to.satisfy(msg => 
      msg.includes("100") || msg.includes("exceed") || msg.includes("characters")
    );
  });
}
