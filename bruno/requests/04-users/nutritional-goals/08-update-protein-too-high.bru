meta {
  name: Update Nutritional Goals - Protein Too High
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/users/nutritional-goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dailyCalories": 2000.0,
    "dailyProtein": 1001.0,
    "dailyCarbs": 200.0,
    "dailyFats": 65.0
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Protein validation error for too high", function() {
    expect(res.body.details).to.have.property("dailyProtein");
    expect(res.body.details.dailyProtein).to.satisfy(msg => 
      msg.includes("1000") || msg.includes("exceed") || msg.includes("not exceed")
    );
  });
}
