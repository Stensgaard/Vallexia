meta {
  name: Update Nutritional Goals - Calories Too High
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/users/nutritional-goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dailyCalories": 10001.0,
    "dailyProtein": 150.0,
    "dailyCarbs": 200.0,
    "dailyFats": 65.0
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Daily calories validation error for too high", function() {
    expect(res.body.details).to.have.property("dailyCalories");
    expect(res.body.details.dailyCalories).to.satisfy(msg => 
      msg.includes("10000") || msg.includes("exceed") || msg.includes("not exceed")
    );
  });
}
