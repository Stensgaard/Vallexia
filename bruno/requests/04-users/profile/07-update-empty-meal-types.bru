meta {
  name: Update User Profile - Empty Meal Types
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "test@example.com",
    "householdSize": 2,
    "mealTypes": []
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("Meal types validation error", function() {
    expect(res.body.details).to.have.property("mealTypes");
    expect(res.body.details.mealTypes).to.satisfy(msg => 
      msg.includes("At least one") || msg.includes("not be empty") || msg.includes("required")
    );
  });
}
