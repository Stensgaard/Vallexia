meta {
  name: Get User Audit Logs - Admin Success
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/audit-logs/user/1?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains audit logs", function() {
    expect(res.body).to.have.property("content");
    expect(res.body.content).to.be.an("array");
  });
}
