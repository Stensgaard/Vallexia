meta {
  name: Get Security Violations - Admin Success
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/audit-logs/security-violations?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains security violations", function() {
    expect(res.body).to.have.property("content");
  });
}
