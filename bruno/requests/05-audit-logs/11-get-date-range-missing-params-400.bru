meta {
  name: Get Audit Logs By Date Range - Missing Parameters 400
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/audit-logs/date-range?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 400 Bad Request (missing required parameters)", function() {
    expect(res.status).to.equal(400);
  });
}
