meta {
  name: Get Audit Logs By Date Range - Invalid Format 400
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/audit-logs/date-range?start=2024-01-01&end=2024-01-31&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 400 Bad Request (invalid date format)", function() {
    expect(res.status).to.equal(400);
  });
}
