meta {
  name: Get Audit Logs By Date Range - Admin Success
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/audit-logs/date-range?start=2024-01-01T00:00:00&end=2024-01-31T23:59:59&page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

tests {
  test("Status is 200 OK (requires ADMIN role)", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains audit logs in date range", function() {
    expect(res.body).to.have.property("content");
  });
}
