meta {
  name: Get All Audit Logs - Forbidden User Role
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/audit-logs?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 403 Forbidden (requires ADMIN role)", function() {
    expect(res.status).to.equal(403);
  });

  test("Error code is AUTH_005", function() {
    expect(res.body.code).to.equal("AUTH_005");
  });
}
