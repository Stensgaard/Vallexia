# Environment Variables Template - SECRETS ONLY
# Copy this file to .env and fill in your secure values
#
# DEVELOPMENT MODE:
#   - The .env file is automatically loaded by the application
#   - Variables are read from this file
#
# PRODUCTION MODE:
#   - The .env file is NOT

# Database Configuration
DB_PASSWORD=your_secure_database_password_here
# Optional: Database host
#   Development: defaults to 'localhost' (set in .env if different)
#   Production: defaults to 'postgres' (set via Docker/K8s if different)
DB_HOST=localhost

# Redis Configuration
# Redis Password (leave empty if no password)
REDIS_PASSWORD=
# Optional: Redis host
#   Development: defaults to 'localhost' (set in .env if different)
#   Production: defaults to 'redis' (set via Docker/K8s if different)
REDIS_HOST=localhost

# JWT Secret (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
